<?xml version="1.0" encoding="utf-8"?>
<!-- Source des paquets : nuget.org (une installation neuve du SDK peut n'en avoir aucune). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>

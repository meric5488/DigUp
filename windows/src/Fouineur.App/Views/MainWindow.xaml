<Window x:Class="Fouineur.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Fouineur.App.ViewModels"
        xmlns:inf="clr-namespace:Fouineur.App.Infrastructure"
        xmlns:ctl="clr-namespace:Fouineur.App.Controls"
        Title="Fouineur" Icon="/Assets/fouineur.ico"
        Width="1360" Height="860" MinWidth="960" MinHeight="580"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Mode liste : une ligne riche par résultat -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type vm:ResultViewModel}">
            <Grid Margin="2,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Top">
                    <Border Width="36" Height="36" CornerRadius="6" Background="{Binding TypeBrush}">
                        <TextBlock Text="{Binding TypeGlyph}" Style="{StaticResource Icon}" FontSize="17" Foreground="White" HorizontalAlignment="Center" />
                    </Border>
                    <Border Background="#924EEB" CornerRadius="8" MinWidth="16" Height="16" Padding="4,0"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-6,-6,0,0"
                            Visibility="{Binding NumberText, Converter={StaticResource BoolToVis}}" ToolTip="Source citée par Claude">
                        <TextBlock Text="{Binding NumberText}" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <StackPanel Grid.Column="1" Margin="8,0,12,0">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                    <TextBlock inf:Highlight.Text="{Binding Snippet}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38"
                               Margin="0,2,0,0" FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding KindGlyph}" Style="{StaticResource Icon}" FontSize="12" Foreground="{Binding KindBrush}" />
                        <TextBlock Text="{Binding KindLabel}" Style="{StaticResource Caption}" Margin="5,0,0,0" Foreground="{Binding KindBrush}" />
                        <TextBlock Text="  ·  " Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}" MaxWidth="560" />
                        <Border Margin="8,0,0,0" Padding="6,0" CornerRadius="4" VerticalAlignment="Center"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                Visibility="{Binding ByMeaningOnly, Converter={StaticResource BoolToVis}}"
                                ToolTip="Trouvé grâce au sens de la requête, sans les mots exacts">
                            <TextBlock Text="par le sens" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding DateText}" Style="{StaticResource Caption}" VerticalAlignment="Top" ToolTip="{Binding DateFull}" />
            </Grid>
        </DataTemplate>

        <!-- Mode vignettes -->
        <DataTemplate x:Key="TileTemplate" DataType="{x:Type vm:ResultViewModel}">
            <Grid Width="172" Height="206" Margin="2" ToolTip="{Binding Title}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="124" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border CornerRadius="6" Background="{Binding TypeBrush}" ClipToBounds="True">
                    <Grid>
                        <TextBlock Text="{Binding TypeGlyph}" Style="{StaticResource Icon}" FontSize="44" Foreground="White"
                                   HorizontalAlignment="Center" Opacity="0.95"
                                   Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisInv}}" />
                        <Border Background="White" CornerRadius="6" Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}">
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6" Padding="5,2" CornerRadius="4" Background="#B0000000">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding KindGlyph}" Style="{StaticResource Icon}" FontSize="11" Foreground="White" />
                                <TextBlock Text="{Binding KindLabel}" FontSize="11" Foreground="White" Margin="4,0,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Margin="2,6,2,0"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" />
                <TextBlock Grid.Row="2" Text="{Binding Location}" Style="{StaticResource Caption}" Margin="2,2,2,0" />
            </Grid>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="ListPanel">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="TilePanel">
            <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding SyncCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding SettingsCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding ListViewCommand}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding TileViewCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding TogglePreviewCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ───────── Barre du haut : recherche et affichage ───────── -->
        <Grid Margin="16,12,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Assets/fouineur.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="Fouineur" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <Grid Grid.Column="1" MaxWidth="900" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Choix du mode : index (texte et sens, à chaque frappe) ou question à Claude (Entrée) -->
                <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Margin="0,0,8,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton IsChecked="{Binding IsIndexMode, Mode=OneWay}" Command="{Binding IndexModeCommand}"
                                      Padding="10,7" BorderThickness="0" ToolTip="Recherche dans l'index : mots exacts et sens, résultats à chaque frappe">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" />
                                <TextBlock Text="Index" Margin="6,0,0,0" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding IsClaudeMode, Mode=OneWay}" Command="{Binding ClaudeModeCommand}"
                                      Padding="10,7" BorderThickness="0" ToolTip="Poser une question à Claude : réponse rédigée, avec les documents sources">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✦" FontFamily="Segoe UI Symbol" FontSize="13" VerticalAlignment="Center" Foreground="#924EEB" />
                                <TextBlock Text="Claude" Margin="6,0,0,0" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding IsInventoryMode, Mode=OneWay}" Command="{Binding InventoryModeCommand}"
                                      Visibility="{Binding IsGlpiCategory, Converter={StaticResource BoolToVis}}"
                                      Padding="10,7" BorderThickness="0" ToolTip="Inventaire du parc GLPI : tableau complet des postes, logiciels, versions, systèmes et IP">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F8;" Style="{StaticResource Icon}" FontSize="13" />
                                <TextBlock Text="Inventaire" Margin="6,0,0,0" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1">
                    <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="15" Padding="38,8,72,8" VerticalContentAlignment="Center"
                             PreviewKeyDown="SearchBox_PreviewKeyDown" />
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="13,0,0,0" HorizontalAlignment="Left"
                               IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding SearchPlaceholder}" Margin="40,0,72,0" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" FontSize="15" IsHitTestVisible="False"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Visibility="{Binding HasQuery, Converter={StaticResource BoolToVisInv}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
                        <Button Padding="8,4" Background="Transparent" BorderThickness="0"
                                Command="{Binding ClearCommand}" ToolTip="Effacer (Échap)"
                                Visibility="{Binding HasQuery, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="12" />
                        </Button>
                        <Button Padding="8,4" Background="Transparent" BorderThickness="0"
                                Command="{Binding AskClaudeCommand}" ToolTip="Demander à Claude (Entrée)"
                                Visibility="{Binding IsClaudeMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xE724;" Style="{StaticResource Icon}" FontSize="14" Foreground="#924EEB" />
                        </Button>
                        <Button Padding="8,4" Background="Transparent" BorderThickness="0"
                                Command="{Binding RunInventoryCommand}" ToolTip="Interroger l'inventaire (Entrée) — une phrase est interprétée par Claude"
                                Visibility="{Binding IsInventoryMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xE724;" Style="{StaticResource Icon}" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                <ComboBox ItemsSource="{Binding DateFilters}" DisplayMemberPath="Value" SelectedValuePath="Key"
                          SelectedValue="{Binding Date}" MinWidth="150" VerticalAlignment="Center" ToolTip="Période" />
                <ToggleButton IsChecked="{Binding SortByDate}" Margin="8,0,0,0" Padding="10,7" ToolTip="Trier par date (sinon par pertinence)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8CB;" Style="{StaticResource Icon}" FontSize="14" />
                        <TextBlock Text="Récents" Margin="6,0,0,0" />
                    </StackPanel>
                </ToggleButton>
                <Border Margin="12,0,0,0" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton IsChecked="{Binding IsTileView, Mode=OneWay, Converter={StaticResource Not}}" Command="{Binding ListViewCommand}"
                                      Padding="10,7" BorderThickness="0" ToolTip="Liste (Ctrl+1)">
                            <TextBlock Text="&#xE8FD;" Style="{StaticResource Icon}" FontSize="14" />
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding IsTileView, Mode=OneWay}" Command="{Binding TileViewCommand}"
                                      Padding="10,7" BorderThickness="0" ToolTip="Vignettes (Ctrl+2)">
                            <TextBlock Text="&#xE80A;" Style="{StaticResource Icon}" FontSize="14" />
                        </ToggleButton>
                    </StackPanel>
                </Border>
                <ToggleButton IsChecked="{Binding ShowPreview}" Margin="8,0,0,0" Padding="10,7" ToolTip="Volet d'aperçu (Ctrl+P)">
                    <TextBlock Text="&#xE89F;" Style="{StaticResource Icon}" FontSize="14" />
                </ToggleButton>
                <Button Command="{Binding SyncCommand}" Margin="12,0,0,0" Padding="10,7" ToolTip="Synchroniser maintenant (F5)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="14" />
                        <TextBlock Text="Synchroniser" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding SettingsCommand}" Margin="8,0,0,0" Padding="10,7" ToolTip="Sources et réglages (Ctrl+,)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="14" />
                        <TextBlock Text="Sources" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ───────── Contenu ───────── -->
        <Grid Grid.Row="1" Margin="8,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
                <ColumnDefinition x:Name="PreviewColumn" Width="460" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <!-- Catégories et sources -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                <StackPanel>
                    <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CategoryViewModel}">
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{Binding Accent}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" FontSize="14" />
                                    <TextBlock Grid.Column="2" Text="{Binding CountText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <TextBlock Text="Sources" Style="{StaticResource SectionTitle}" Margin="12,20,0,6" />
                    <ItemsControl ItemsSource="{Binding Sources}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SourceStatusViewModel}">
                                <ToggleButton IsChecked="{Binding IsFilter, Mode=OneWay}" Margin="0,2" Padding="10,6" HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent"
                                              Command="{Binding DataContext.SourceFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding}" ToolTip="Limiter les résultats à cette source (cliquer à nouveau pour annuler)">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="11" TextWrapping="NoWrap" ToolTip="{Binding Detail}" />
                                        </StackPanel>
                                    </Grid>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Gérer les sources…" Command="{Binding SettingsCommand}" Margin="10,8,0,0" HorizontalAlignment="Left" />
                </StackPanel>
            </ScrollViewer>

            <!-- Résultats -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="6,0,6,6" Visibility="{Binding IsNotInventoryMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource Caption}" />
                    <ProgressBar IsIndeterminate="True" Height="2" VerticalAlignment="Bottom" Margin="0,0,0,-4"
                                 Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!-- Réponse de Claude -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8"
                        BorderBrush="#924EEB" Visibility="{Binding HasClaudePanel, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Command="{Binding CopyAnswerCommand}" Padding="6,3" Background="Transparent" BorderThickness="0" ToolTip="Copier la réponse">
                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="13" />
                                </Button>
                                <Button Command="{Binding CancelClaudeCommand}" Padding="6,3" Background="Transparent" BorderThickness="0" ToolTip="Interrompre"
                                        Visibility="{Binding IsClaudeBusy, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="12" />
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✦" FontFamily="Segoe UI Symbol" FontSize="15" Foreground="#924EEB" VerticalAlignment="Center" />
                                <TextBlock Text="Réponse de Claude" FontWeight="SemiBold" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Grid.Row="1" Text="{Binding ClaudePlan}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding ClaudePlan, Converter={StaticResource BoolToVis}}" />
                        <ScrollViewer Grid.Row="2" MaxHeight="300" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"
                                      Visibility="{Binding ClaudeAnswer, Converter={StaticResource BoolToVis}}">
                            <TextBlock x:Name="ClaudeAnswerText" TextWrapping="Wrap" FontSize="14" LineHeight="21" />
                        </ScrollViewer>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                            <ProgressBar IsIndeterminate="True" Width="70" Height="3" VerticalAlignment="Center" Margin="0,0,10,0"
                                         Visibility="{Binding IsClaudeBusy, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding ClaudeStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Inventaire : tableau complet (calculé sur ce poste) -->
                <Grid Grid.Row="0" Grid.RowSpan="3" Visibility="{Binding IsInventoryMode, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="6,0,2,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Command="{Binding CopyInventoryCommand}" Padding="8,4" Margin="0,0,6,0" ToolTip="Copier le tableau (à coller dans Excel ou un mail)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="13" />
                                    <TextBlock Text="Copier" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ExportInventoryCommand}" Padding="8,4" ToolTip="Exporter en CSV pour Excel">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="13" />
                                    <TextBlock Text="Exporter (Excel)" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding InventorySummary}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding InventoryInterpretation}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <ProgressBar IsIndeterminate="True" Height="2" Margin="0,4,0,0"
                                         Visibility="{Binding IsInventoryBusy, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="2">
                        <DataGrid x:Name="InventoryGrid" ItemsSource="{Binding InventoryRows}" SelectedItem="{Binding SelectedInventoryRow}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" CanUserResizeColumns="True"
                                  CanUserReorderColumns="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  SelectionMode="Extended" SelectionUnit="FullRow" BorderThickness="0" Background="Transparent"
                                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  ClipboardCopyMode="IncludeHeader" MouseDoubleClick="InventoryGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Poste" Binding="{Binding Asset}" Width="150" />
                                <DataGridTextColumn Header="Logiciel" Binding="{Binding Software}" Width="220" />
                                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="110" />
                                <DataGridTextColumn Header="Système" Binding="{Binding Os}" Width="240" />
                                <DataGridTextColumn Header="Adresses IP" Binding="{Binding Ips}" Width="150" />
                                <DataGridTextColumn Header="Utilisateur" Binding="{Binding User}" Width="120" />
                                <DataGridTextColumn Header="Lieu" Binding="{Binding Location}" Width="150" />
                                <DataGridTextColumn Header="Type" Binding="{Binding AssetType}" Width="100" />
                                <DataGridTextColumn Header="N° de série" Binding="{Binding Serial}" Width="120" />
                            </DataGrid.Columns>
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Ouvrir la fiche dans GLPI" Command="{Binding OpenCommand}">
                                        <MenuItem.Icon><TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Copier tout le tableau" Command="{Binding CopyInventoryCommand}">
                                        <MenuItem.Icon><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Exporter en CSV (Excel)" Command="{Binding ExportInventoryCommand}">
                                        <MenuItem.Icon><TextBlock Text="&#xE896;" Style="{StaticResource Icon}" /></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                        </DataGrid>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4" Visibility="{Binding IsNotInventoryMode, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <ListView x:Name="ResultsList" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}"
                                  BorderThickness="0" Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  MouseDoubleClick="ResultsList_MouseDoubleClick" KeyDown="ResultsList_KeyDown">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Ouvrir" Command="{Binding OpenCommand}" InputGestureText="Entrée">
                                        <MenuItem.Icon><TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Ouvrir l'emplacement" Command="{Binding OpenContainerCommand}" InputGestureText="Ctrl+Entrée">
                                        <MenuItem.Icon><TextBlock Text="&#xE838;" Style="{StaticResource Icon}" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Ouvrir dans le webmail" Command="{Binding OpenWebmailCommand}">
                                        <MenuItem.Icon><TextBlock Text="&#xE774;" Style="{StaticResource Icon}" /></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Copier le lien ou le chemin" Command="{Binding CopyLinkCommand}">
                                        <MenuItem.Icon><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" /></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </ListView.ContextMenu>
                        </ListView>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="40" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter x:Name="Splitter" Grid.Column="2" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" ShowsPreview="False" />

            <!-- Aperçu -->
            <Border x:Name="PreviewPane" Grid.Column="3" Style="{StaticResource Card}" Padding="0" Margin="0,22,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- En-tête -->
                    <Grid Margin="16,16,16,8" DataContext="{Binding SelectedResult}"
                          Visibility="{Binding Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="8" Background="{Binding TypeBrush}" VerticalAlignment="Top">
                            <TextBlock Text="{Binding TypeGlyph}" Style="{StaticResource Icon}" FontSize="21" Foreground="White" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap">
                                <Run Text="{Binding KindLabel, Mode=OneWay}" Foreground="{Binding KindBrush, Mode=OneWay}" />
                                <Run Text=" · " /><Run Text="{Binding TypeLabel, Mode=OneWay}" />
                                <Run Text=" · " /><Run Text="{Binding DateFull, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Location}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Visibility="{Binding Author, Converter={StaticResource BoolToVis}}">
                                <Run Text="Auteur : " /><Run Text="{Binding Author, Mode=OneWay}" />
                                <Run Text="{Binding Size, Mode=OneWay, StringFormat=' · {0}'}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- Actions -->
                    <WrapPanel Grid.Row="1" Margin="16,0,16,10" Visibility="{Binding SelectedResult, Converter={StaticResource BoolToVis}}">
                        <Button Command="{Binding OpenCommand}" Padding="12,6" Margin="0,0,8,6"
                                Background="{DynamicResource AccentFillColorDefaultBrush}" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                ToolTip="Ouvrir depuis son emplacement d'origine (Entrée)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="14" />
                                <TextBlock Text="Ouvrir" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenContainerCommand}" Padding="12,6" Margin="0,0,8,6" ToolTip="Dossier, bibliothèque, canal… (Ctrl+Entrée)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="14" />
                                <TextBlock Text="Emplacement" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenWebmailCommand}" Padding="12,6" Margin="0,0,8,6" x:Name="WebmailButton">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="14" />
                                <TextBlock Text="Webmail" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CopyLinkCommand}" Padding="10,6" Margin="0,0,8,6" ToolTip="Copier le lien ou le chemin">
                            <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="14" />
                        </Button>
                    </WrapPanel>

                    <!-- Corps de l'aperçu -->
                    <Grid Grid.Row="2" Margin="1,0,1,1">
                        <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                        <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                            <ProgressBar IsIndeterminate="True" Width="160" />
                            <TextBlock Text="Préparation de l'aperçu…" Style="{StaticResource Caption}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                        <ctl:PreviewHost x:Name="Host" Margin="0,1,0,0" Visibility="Collapsed" />
                        <Grid x:Name="TextPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding PreviewNote}" Style="{StaticResource Caption}" Margin="16,8,16,0" TextWrapping="Wrap"
                                       Visibility="{Binding PreviewNote, Converter={StaticResource BoolToVis}}" />
                            <FlowDocumentScrollViewer x:Name="TextView" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                                      IsToolBarVisible="False" Zoom="100" Padding="0" />
                        </Grid>
                        <TextBlock x:Name="NoPreview" Text="Sélectionnez un résultat pour l'aperçu." Style="{StaticResource Caption}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ───────── Barre d'état ───────── -->
        <Grid Grid.Row="2" Margin="16,8,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <ProgressBar Width="140" Height="4" VerticalAlignment="Center" Margin="0,0,10,0"
                             Value="{Binding SyncPercent, Mode=OneWay}" IsIndeterminate="{Binding SyncIndeterminate, Mode=OneWay}"
                             Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding SyncText}" Style="{StaticResource Caption}" VerticalAlignment="Center" MaxWidth="700" />
                <Button Command="{Binding CancelSyncCommand}" Margin="8,0,0,0" Padding="6,2" Background="Transparent" BorderThickness="0"
                        ToolTip="Interrompre la synchronisation" Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11" />
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="{Binding EmbedderStatus}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                <TextBlock Text="  ·  " Style="{StaticResource Caption}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding IndexSummary}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                <!-- Logo de l'entreprise (chargé dans le code : facultatif) -->
                <Border x:Name="CompanyLogoBadge" Margin="14,0,0,0" Padding="6,2" CornerRadius="4" Background="White"
                        VerticalAlignment="Center" ToolTip="Ingecap" Visibility="Collapsed">
                    <Image x:Name="CompanyLogo" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

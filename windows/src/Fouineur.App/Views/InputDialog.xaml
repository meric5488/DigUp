<Window x:Class="Fouineur.App.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fouineur" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,0,0,12" />
        <TextBox x:Name="Input" />
        <PasswordBox x:Name="Secret" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Valider" IsDefault="True" MinWidth="90" Click="Ok_Click"
                    Background="{DynamicResource AccentFillColorDefaultBrush}" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Button Content="Annuler" IsCancel="True" MinWidth="90" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>

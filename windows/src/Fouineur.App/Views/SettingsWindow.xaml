<Window x:Class="Fouineur.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Fouineur.App.ViewModels"
        Title="Sources et réglages — Fouineur" Icon="/Assets/fouineur.ico"
        Width="1120" Height="780" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl>
            <!-- ═════════════════════ Sources ═════════════════════ -->
            <TabItem Header="Sources">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Liste des sources -->
                    <DockPanel Margin="0,0,16,0">
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <TextBlock Text="Ajouter une source" Style="{StaticResource Caption}" Margin="4,0,0,6" />
                            <Button Command="{Binding AddM365Command}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,7" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE753;" Style="{StaticResource Icon}" FontSize="14" />
                                    <TextBlock Text="Microsoft 365 (OneDrive, SharePoint, Teams)" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding AddZimbraCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,7" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE715;" Style="{StaticResource Icon}" FontSize="14" />
                                    <TextBlock Text="Messagerie Zimbra" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding AddGlpiCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,7" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE90F;" Style="{StaticResource Icon}" FontSize="14" />
                                    <TextBlock Text="GLPI (tickets, base de connaissances, inventaire)" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding AddLocalCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,7" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="14" />
                                    <TextBlock Text="Dossiers et partages réseau" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RemoveSourceCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,7" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" />
                                    <TextBlock Text="Supprimer la source sélectionnée" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="12"
                                Visibility="{Binding FirstRun, Converter={StaticResource BoolToVis}}">
                            <TextBlock TextWrapping="Wrap">
                                <Run FontWeight="SemiBold" Text="Bienvenue !" />
                                <LineBreak />
                                <Run Text="Ajoutez vos sources ci-dessous, puis cochez ce qu'il faut indexer. La première synchronisation démarre à la fermeture de cette fenêtre." />
                            </TextBlock>
                        </Border>
                        <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SourceEditorViewModel}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- Éditeur de la source sélectionnée -->
                    <Grid Grid.Column="1" DataContext="{Binding SelectedSource}"
                          Visibility="{Binding Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- En-tête -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="26" Margin="0,0,12,0" />
                            <StackPanel Grid.Column="1">
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="16" FontWeight="SemiBold" MaxWidth="460" HorizontalAlignment="Left" MinWidth="280" />
                                <TextBlock Margin="2,4,0,0" Style="{StaticResource Caption}">
                                    <Run Text="{Binding TypeLabel, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding LastSyncText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding LastError}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="2,2,0,0"
                                           Visibility="{Binding LastError, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                <CheckBox Content="Active" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Button Command="{Binding SyncNowCommand}" Padding="10,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="14" />
                                        <TextBlock Text="Synchroniser" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Connexion -->
                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                            <!-- Fichiers locaux / partages -->
                            <Border Style="{StaticResource Card}" Visibility="{Binding IsLocal, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Dossiers et partages à surveiller" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding Paths}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="1" Padding="6,3" Background="Transparent" BorderThickness="0" ToolTip="Retirer"
                                                            Command="{Binding DataContext.RemovePathCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding NewPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ex. : \\serveur\partage\Service ou D:\Archives" />
                                        <Button Grid.Column="1" Content="Ajouter" Command="{Binding AddPathCommand}" Margin="8,0,0,0" />
                                        <Button Grid.Column="2" Content="Parcourir…" Command="{Binding AddFolderCommand}" Margin="8,0,0,0" />
                                    </Grid>
                                    <TextBlock Text="Chemin local, lecteur réseau ou partage UNC (\\serveur\partage). Un partage hors ligne est simplement ignoré jusqu'à son retour."
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <Expander Header="Options" Margin="0,8,0,0">
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Ignorer" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,6,12,0" />
                                            <TextBox Grid.Column="1" Text="{Binding ExcludePatterns}" AcceptsReturn="True" Height="80" VerticalScrollBarVisibility="Auto"
                                                     ToolTip="Un motif par ligne : nom exact ou jokers (*.tmp, ~$*, node_modules)" />
                                            <TextBlock Grid.Row="1" Text="Taille max. (Mo)" Style="{StaticResource FieldLabel}" Margin="0,8,12,0" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MaxFileSizeMb}" Width="90" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                     ToolTip="Au-delà, le fichier est trouvé par son nom seulement" />
                                        </Grid>
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <!-- Microsoft 365 -->
                            <Border Style="{StaticResource Card}" Visibility="{Binding IsM365, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="ID d'application (client)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Column="1" Text="{Binding ClientId, UpdateSourceTrigger=LostFocus}"
                                             ToolTip="Inscription d'application Entra ID « Fouinneur » (client public, redirection WAM)" />
                                    <TextBlock Grid.Row="1" Text="Locataire" Style="{StaticResource FieldLabel}" Margin="0,8,12,0" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Tenant, UpdateSourceTrigger=LostFocus}" Margin="0,8,0,0"
                                             ToolTip="« organizations », le domaine (contoso.fr) ou l'ID du locataire" />
                                    <TextBlock Grid.Row="2" Text="Compte" Style="{StaticResource FieldLabel}" Margin="0,10,12,0" />
                                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="{Binding AccountName, TargetNullValue='non connecté', FallbackValue='non connecté'}" VerticalAlignment="Center" MinWidth="200" />
                                        <Button Command="{Binding SignInCommand}" Margin="12,0,0,0" Padding="12,6"
                                                Background="{DynamicResource AccentFillColorDefaultBrush}" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="14" />
                                                <TextBlock Text="Se connecter" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button Content="Se déconnecter" Command="{Binding SignOutCommand}" Margin="8,0,0,0"
                                                Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <Expander Grid.Row="3" Grid.ColumnSpan="3" Header="Historique Teams" Margin="0,10,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="Conversations : jours" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding ChatHistoryDays}" Width="70" />
                                            <TextBlock Text="Canaux : jours" Style="{StaticResource FieldLabel}" Margin="24,0,12,0" />
                                            <TextBox Text="{Binding ChannelHistoryDays}" Width="70" />
                                        </StackPanel>
                                    </Expander>
                                </Grid>
                            </Border>

                            <!-- Zimbra -->
                            <Border Style="{StaticResource Card}" Visibility="{Binding IsZimbra, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Serveur" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding ServerUrl, UpdateSourceTrigger=LostFocus}" ToolTip="Ex. : https://mail.exemple.fr" />
                                    <TextBlock Grid.Row="1" Text="Identifiant" Style="{StaticResource FieldLabel}" Margin="0,8,12,0" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding UserName, UpdateSourceTrigger=LostFocus}" Margin="0,8,0,0" ToolTip="Adresse de votre boîte personnelle" />
                                    <TextBlock Grid.Row="2" Text="Mot de passe" Style="{StaticResource FieldLabel}" Margin="0,8,12,0" />
                                    <PasswordBox GotFocus="SelectAllOnFocus" x:Name="ZimbraPassword" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" LostFocus="ZimbraPassword_LostFocus" />
                                    <Button Grid.Row="2" Grid.Column="2" Margin="8,8,0,0" Padding="12,6" Click="TestZimbra_Click"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="14" />
                                            <TextBlock Text="Se connecter" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Mot de passe enregistré (chiffré pour votre session Windows)." Style="{StaticResource Caption}" Margin="0,4,0,0"
                                               Visibility="{Binding HasPassword, Converter={StaticResource BoolToVis}}" />
                                    <Expander Grid.Row="4" Grid.ColumnSpan="3" Header="Boîtes supplémentaires et webmail" Margin="0,10,0,0" IsExpanded="True">
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Text="Comptes délégués (accès à toute la boîte), lus avec vos identifiants. Les dossiers partagés montés dans votre boîte apparaissent directement dans la liste ci-dessous."
                                                       Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding ExtraAccounts}" Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock VerticalAlignment="Center">
                                                                <Run Text="&#xE715;" FontFamily="{StaticResource IconFont}" /><Run Text="  " /><Run Text="{Binding Mode=OneWay}" />
                                                            </TextBlock>
                                                            <Button Grid.Column="1" Padding="6,3" Background="Transparent" BorderThickness="0" ToolTip="Retirer"
                                                                    Command="{Binding DataContext.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}">
                                                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding NewAccount, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ex. : compta@exemple.fr" />
                                                <Button Grid.Column="1" Content="Ajouter la boîte" Command="{Binding AddAccountCommand}" Margin="8,0,0,0" />
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <TextBlock Text="Lien webmail" Style="{StaticResource FieldLabel}" />
                                                <TextBox Text="{Binding WebmailTemplate}" MinWidth="420" ToolTip="Variables : {base} {id} {account} {folder}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>
                                </Grid>
                            </Border>
                            <!-- GLPI -->
                            <Border Style="{StaticResource Card}" Visibility="{Binding IsGlpi, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Adresse de GLPI" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding ServerUrl, UpdateSourceTrigger=LostFocus}" ToolTip="Ex. : https://glpi.exemple.fr (le suffixe /apirest.php est facultatif)" />
                                    <TextBlock Grid.Row="1" Text="Jeton d'API" Style="{StaticResource FieldLabel}" Margin="0,8,12,0" />
                                    <PasswordBox GotFocus="SelectAllOnFocus" x:Name="GlpiUserToken" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" LostFocus="GlpiTokens_LostFocus"
                                                 ToolTip="Votre jeton personnel : Préférences › Clés d'accès distant › Jeton d'API" />
                                    <Button Grid.Row="1" Grid.Column="2" Margin="8,8,0,0" Padding="12,6" Click="TestGlpi_Click"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="14" />
                                            <TextBlock Text="Se connecter" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Jeton enregistré (chiffré pour votre session Windows)." Style="{StaticResource Caption}" Margin="0,4,0,0"
                                               Visibility="{Binding HasGlpiToken, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Grid.Row="3" Text="App-Token" Style="{StaticResource FieldLabel}" Margin="0,8,12,0" />
                                    <PasswordBox GotFocus="SelectAllOnFocus" x:Name="GlpiAppToken" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" LostFocus="GlpiTokens_LostFocus"
                                                 ToolTip="Facultatif : jeton du client API (Configuration › Générale › API) s'il est exigé" />
                                    <Button Grid.Row="3" Grid.Column="2" Margin="8,8,0,0" Padding="10,6" Content="Effacer" Click="ClearGlpiApp_Click"
                                            Visibility="{Binding HasGlpiAppToken, Converter={StaticResource BoolToVis}}" ToolTip="Supprimer l'App-Token enregistré" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="App-Token enregistré." Style="{StaticResource Caption}" Margin="0,4,0,0"
                                               Visibility="{Binding HasGlpiAppToken, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Grid.Row="5" Text="Historique" Style="{StaticResource FieldLabel}" Margin="0,10,12,0" />
                                    <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBox Text="{Binding GlpiHistoryDays, UpdateSourceTrigger=LostFocus}" Width="80" />
                                        <TextBlock Text="jours de tickets, problèmes et changements (0 = tout)" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="6" Grid.ColumnSpan="3" Margin="0,10,0,0" TextWrapping="Wrap" Style="{StaticResource Caption}"
                                               Text="Fouineur lit GLPI avec vos droits : seuls les tickets, articles et matériels que vous voyez dans GLPI sont indexés. Cochez ci-dessous ce qu'il faut synchroniser ; un clic sur un résultat ouvre la fiche dans GLPI." />
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding Status}" Margin="2,8,0,0" TextWrapping="Wrap" Visibility="{Binding Status, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <!-- Sélection -->
                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Que faut-il indexer ?" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Command="{Binding RefreshTreeCommand}" Margin="12,0,0,0" Padding="8,4" ToolTip="Recharger la liste">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" />
                                        <TextBlock Text="Actualiser" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <ProgressBar IsIndeterminate="True" Width="80" Margin="12,0,0,0" VerticalAlignment="Center"
                                             Visibility="{Binding IsTreeLoading, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <!-- Recherche de sites SharePoint -->
                            <Grid Grid.Row="1" Margin="0,8,0,0" Visibility="{Binding IsM365, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SiteQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nom d'un site SharePoint à retrouver" />
                                <Button Grid.Column="1" Content="Chercher un site" Command="{Binding SearchSitesCommand}" Margin="8,0,0,0" />
                            </Grid>

                            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4" Margin="0,8,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <!-- résultats de recherche de sites -->
                                    <ItemsControl ItemsSource="{Binding SiteResults}" Margin="8,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:NodeViewModel}">
                                                <CheckBox IsChecked="{Binding IsChecked}" Margin="0,2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="13" />
                                                        <TextBlock Text="{Binding Name}" Margin="6,0,0,0" />
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                                                    </StackPanel>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TreeView Grid.Row="1" ItemsSource="{Binding Roots}" BorderThickness="0" Background="Transparent"
                                              VirtualizingPanel.IsVirtualizing="True">
                                        <TreeView.ItemContainerStyle>
                                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                            </Style>
                                        </TreeView.ItemContainerStyle>
                                        <TreeView.ItemTemplate>
                                            <HierarchicalDataTemplate DataType="{x:Type vm:NodeViewModel}" ItemsSource="{Binding Children}">
                                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                                    <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding Selectable}" VerticalAlignment="Center"
                                                              MinWidth="0" Padding="0" Margin="0,0,4,0" Focusable="False" />
                                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    <ProgressBar IsIndeterminate="True" Width="40" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </HierarchicalDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>
                                    <TextBlock Grid.Row="1" Text="{Binding TreeHint}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" TextAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Récapitulatif des règles -->
                            <StackPanel Grid.Column="1" Grid.RowSpan="3" Margin="16,0,0,0">
                                <TextBlock Text="Sélection actuelle" FontWeight="SemiBold" />
                                <TextBlock Text="Cocher un élément inclut tout son contenu, y compris ce qui sera créé plus tard. Décocher le retire de l'index dès la fermeture de cette fenêtre."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,8" />
                                <ItemsControl ItemsSource="{Binding RuleSummaries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2" FontSize="12" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ═════════════════════ Recherche par le sens ═════════════════════ -->
            <TabItem Header="Recherche par le sens">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock TextWrapping="Wrap" Text="En plus des mots exacts, Fouineur peut retrouver les documents qui parlent de la même chose avec d'autres mots. Le modèle tourne entièrement sur ce poste : rien ne sort de votre ordinateur." />
                        <TextBlock Text="Moteur" Style="{StaticResource SectionTitle}" />
                        <RadioButton GroupName="prov" Content="EmbeddingGemma en local (ONNX, accéléré par la carte graphique si possible)"
                                     IsChecked="{Binding Provider, Converter={StaticResource Equals}, ConverterParameter=onnx}" />
                        <RadioButton GroupName="prov" Content="Ollama (serveur local ou du réseau)" Margin="0,6,0,0"
                                     IsChecked="{Binding Provider, Converter={StaticResource Equals}, ConverterParameter=ollama}" />
                        <RadioButton GroupName="prov" Content="Désactivée (mots exacts seulement)" Margin="0,6,0,0"
                                     IsChecked="{Binding Provider, Converter={StaticResource Equals}, ConverterParameter=none}" />

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="{Binding IsOnnx, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Dossier du modèle" FontWeight="SemiBold" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding OnnxModelDir, UpdateSourceTrigger=LostFocus}" />
                                    <Button Grid.Column="1" Content="Parcourir…" Command="{Binding BrowseModelCommand}" Margin="8,0,0,0" />
                                    <Button Grid.Column="2" Content="Ouvrir" Command="{Binding OpenFolderCommand}" CommandParameter="{Binding OnnxModelDir}" Margin="8,0,0,0" />
                                </Grid>
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource Caption}">
                                    <Run Text="Téléchargez sur Hugging Face le dépôt onnx-community/embeddinggemma-300m-ONNX et copiez dans ce dossier : onnx/model.onnx, onnx/model.onnx_data et tokenizer.model (une version quantifiée, model_q4.onnx, est aussi acceptée)." />
                                </TextBlock>
                                <TextBlock Margin="0,6,0,0" Text="✔ Modèle trouvé dans ce dossier." Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                           Visibility="{Binding ModelPresent, Converter={StaticResource BoolToVis}}" />
                                <CheckBox Content="Utiliser la carte graphique (DirectML)" IsChecked="{Binding UseDirectML}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="{Binding IsOllama, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Adresse" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding OllamaUrl}" />
                                <TextBlock Grid.Row="1" Text="Modèle" Style="{StaticResource FieldLabel}" Margin="0,8,12,0" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OllamaModel}" Margin="0,8,0,0" ToolTip="ollama pull embeddinggemma" />
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="Dimensions des vecteurs" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding DimensionChoices}" SelectedItem="{Binding Dimensions}" Width="100" />
                            <TextBlock Text="256 : bon compromis vitesse / qualité." Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding EmbedderStatus}" Margin="0,14,0,0" />
                        <Button Content="Recalculer le sens de tout l'index" Command="{Binding ResetVectorsCommand}" Margin="0,10,0,0" HorizontalAlignment="Left" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═════════════════════ Claude ═════════════════════ -->
            <TabItem Header="Claude">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock TextWrapping="Wrap" Text="En mode « Claude », Fouineur cherche d'abord dans l'index local, puis envoie à Claude (Anthropic) uniquement des extraits des documents les plus pertinents pour obtenir une réponse rédigée, avec ses sources." />
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12" BorderBrush="{DynamicResource SystemFillColorCautionBrush}">
                            <TextBlock TextWrapping="Wrap" FontSize="12.5"
                                       Text="Confidentialité : les extraits envoyés quittent ce poste. Décochez ci-dessous les sources qui ne doivent jamais être envoyées (données de santé, données clients…), et vérifiez la compatibilité avec vos engagements HDS / ISO 27001 et le RGPD." />
                        </Border>

                        <TextBlock Text="Clé d'API Anthropic" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox GotFocus="SelectAllOnFocus" x:Name="ClaudeKey" LostFocus="ClaudeKey_LostFocus" ToolTip="Clé créée sur console.anthropic.com (commence par sk-ant-)" />
                            <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,6" Click="TestClaude_Click"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                    Content="Enregistrer et tester" />
                            <Button Grid.Column="2" Margin="8,0,0,0" Content="Supprimer la clé" Command="{Binding RemoveClaudeKeyCommand}" Click="RemoveClaudeKey_Click"
                                    Visibility="{Binding HasClaudeKey, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                        <TextBlock Text="✔ Clé enregistrée (chiffrée pour votre session Windows)." Margin="0,6,0,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                   Visibility="{Binding HasClaudeKey, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding ClaudeTestStatus}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding ClaudeTestStatus, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Text="Modèles" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Analyse de la question" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding ClaudeModels}" Text="{Binding ClaudeAnalysisModel, UpdateSourceTrigger=LostFocus}"
                                      ToolTip="Rapide et peu coûteux : Haiku suffit" />
                            <TextBlock Grid.Row="1" Text="Rédaction de la réponse" Style="{StaticResource FieldLabel}" Margin="0,8,12,0" />
                            <ComboBox Grid.Row="1" Grid.Column="1" IsEditable="True" ItemsSource="{Binding ClaudeModels}" Text="{Binding ClaudeAnswerModel, UpdateSourceTrigger=LostFocus}" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="2" Text="Documents envoyés (max.)" Style="{StaticResource FieldLabel}" Margin="0,8,12,0" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ClaudeMaxDocuments}" Width="80" HorizontalAlignment="Left" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="3" Text="Taille d'un extrait (caractères)" Style="{StaticResource FieldLabel}" Margin="0,8,12,0" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ClaudePassageChars}" Width="80" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </Grid>

                        <TextBlock Text="Sources autorisées à être envoyées à Claude" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Sources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SourceEditorViewModel}">
                                    <CheckBox IsChecked="{Binding AllowClaude}" Margin="0,3">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="13" />
                                            <TextBlock Text="{Binding Name}" Margin="8,0,0,0" />
                                            <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═════════════════════ Général ═════════════════════ -->
            <TabItem Header="Général">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Text="Synchronisation" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                        <CheckBox Content="Synchroniser à l'ouverture de l'application" IsChecked="{Binding SyncAtStartup}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Ensuite, toutes les" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding SyncIntervalMinutes}" Width="70" />
                            <TextBlock Text="minutes" Style="{StaticResource FieldLabel}" Margin="12,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="0 = uniquement quand vous cliquez sur « Synchroniser » (ou F5). La recherche par le sens se calcule à la fin de chaque synchronisation."
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />

                        <TextBlock Text="Ouverture" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="Ouvrir les documents Word, Excel et PowerPoint de SharePoint/OneDrive dans l'application de bureau (sinon dans le navigateur)"
                                  IsChecked="{Binding OpenOfficeInDesktopApp}" />
                        <TextBlock Text="Les mails Zimbra s'ouvrent dans votre messagerie par défaut (fichier .eml) ; le webmail reste accessible par clic droit."
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />

                        <TextBlock Text="Microsoft 365" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ID d'application par défaut" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding DefaultClientId}" Width="340" ToolTip="Proposé pour chaque nouvelle source Microsoft 365" />
                        </StackPanel>

                        <TextBlock Text="Données" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Index et réglages" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding RootPath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="2" Content="Ouvrir" Command="{Binding OpenFolderCommand}" CommandParameter="{Binding RootPath}" Margin="8,0,0,0" />
                            <TextBlock Grid.Row="1" Text="Journaux" Style="{StaticResource FieldLabel}" Margin="0,8,12,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LogsPath}" VerticalAlignment="Center" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Row="1" Grid.Column="2" Content="Ouvrir" Command="{Binding OpenFolderCommand}" CommandParameter="{Binding LogsPath}" Margin="8,8,0,0" />
                        </Grid>
                        <TextBlock Margin="0,24,0,0" Style="{StaticResource Caption}">
                            <Run Text="Fouineur " /><Run Text="{Binding Version, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock Text="Les modifications sont appliquées à la fermeture." Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Content="Fermer" IsDefault="False" IsCancel="True" MinWidth="110" Padding="12,6" Click="Close_Click"
                    Background="{DynamicResource AccentFillColorDefaultBrush}" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </StackPanel>
    </Grid>
</Window>

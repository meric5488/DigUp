<Window x:Class="Fouineur.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fouineur" Width="552" Height="352"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True"
        Style="{x:Null}">
    <Border Margin="16" CornerRadius="12" Background="White" BorderBrush="#E4DCF7" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="6" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Bandeau aux couleurs de l'entreprise -->
            <Border CornerRadius="12,12,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#924EEB" Offset="0" />
                        <GradientStop Color="#4827EC" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image x:Name="CompanyLogo" MaxHeight="90" MaxWidth="320" Stretch="Uniform" Margin="0,0,0,22"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="/Assets/fouineur.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Fouineur" FontSize="30" FontWeight="SemiBold" Foreground="#323639"
                               Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="Tagline" Text="Recherche unifiée : mails, Teams, SharePoint, OneDrive et fichiers"
                           FontSize="13" Foreground="#6B6F73" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="28,0,28,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ProgressBar IsIndeterminate="True" Height="3" Foreground="#924EEB" Background="#EFE8FC" BorderThickness="0" />
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <TextBlock x:Name="Status" Text="Démarrage…" FontSize="12" Foreground="#6B6F73" />
                    <TextBlock x:Name="Version" FontSize="12" Foreground="#9A9EA2" HorizontalAlignment="Right" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
